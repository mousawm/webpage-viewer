<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>7c1f0b2e-5d3a-4a8e-9b61-2f4d8e6a9c10</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Web Page Viewer</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Web Page Viewer"/>
  <Description DefaultValue="Show a live web page inside a slide and use it during the slide show."/>
  <IconUrl DefaultValue="https://mousawm.github.io/webpage-viewer/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://mousawm.github.io/webpage-viewer/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://mousawm.github.io/webpage-viewer/support.html"/>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://mousawm.github.io/webpage-viewer/index.html"/>
    <RequestedWidth>800</RequestedWidth>
    <RequestedHeight>450</RequestedHeight>
  </DefaultSettings>
  <Permissions>Restricted</Permissions>
</OfficeApp>

